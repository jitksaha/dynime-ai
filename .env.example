APP_NAME="Dynime Account"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://account.dynime.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Wildcard session for cross-subdomain SSO (.dynime.com)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.dynime.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Central Dynime Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u740731947_erpapp
DB_USERNAME=u740731947_erpapp
DB_PASSWORD="Pixel#@!194JkS"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database
CACHE_PREFIX=dynime_account_

# SMTP Mail (Email OTP Delivery)
MAIL_MAILER=smtp
MAIL_HOST=smtp.stackmail.com.
MAIL_PORT=587
MAIL_USERNAME=app.notify@dynime.com
MAIL_PASSWORD="Pixel#@!194JkS"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="app.notify@dynime.com"
MAIL_FROM_NAME="Dynime"

# Social Authentication Toggles & Credentials
GOOGLE_ENABLE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="https://account.dynime.com/auth/google/callback"

FACEBOOK_ENABLE=true
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="https://account.dynime.com/auth/facebook/callback"

GITHUB_ENABLE=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="https://account.dynime.com/auth/github/callback"

# Dynime Ecosystem Subdomains
ACCOUNT_DOMAIN=account.dynime.com
ERP_DOMAIN=app.dynime.com
CHAT_DOMAIN=chat.dynime.com
AI_DOMAIN=ai.dynime.com
MAIN_DOMAIN=dynime.com
